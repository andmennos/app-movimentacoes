# Copie para .env (nunca commitado — ver .gitignore) e preencha com um
# valor real. spec.md RC-39/T-77: JWT_SECRET é obrigatório; sem ele, o
# processo (uvicorn ou pytest) falha explicitamente na construção de
# app.config.Settings(), em vez de subir com um segredo previsível.
#
# Gere um valor local com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Este arquivo NUNCA deve conter um segredo funcional — só o nome da
# variável e instruções.
JWT_SECRET=
